# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

rag.md

.env

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — real values never get committed, the template always does
.env*
!.env.example

# vercel
.vercel

# A literal "~" directory: pnpm writes here when HOME is unset or wrong, e.g.
# inside a sandboxed shell. It is a state cache, never project source.
~/

# typescript
*.tsbuildinfo
next-env.d.ts

# database dumps (never commit registrant data)
/backups/

# Editor swap files. A Kate swap for .env.example was committed once; the
# pattern matches the leading-dot form Kate actually writes.
*.kate-swp
.*.kate-swp
*.swp

# pnpm-lock.yaml is THE lockfile — the Dockerfile installs with pnpm and
# package.json pins packageManager to it. A committed package-lock.json made
# the package manager ambiguous: Vercel picked npm, and because dependency
# bumps only ever regenerated the pnpm lockfile, `npm ci` then failed the
# package.json/package-lock.json sync check and three deploys in a row died.
# Running npm locally is fine; the file it writes must not be committed.
package-lock.json
