# Server environment variables
# Copy this file to .env and fill in your values

PORT=5000
NODE_ENV=development

# MongoDB connection string
# Example local: mongodb://127.0.0.1:27017/pstu_it_carnival
# Example Atlas:  mongodb+srv://<user>:<password>@cluster.mongodb.net/pstu_it_carnival
MONGO_URI=mongodb://127.0.0.1:27017/pstu_it_carnival

# Prefix for the generated registration IDs
REGISTRATION_ID_PREFIX=PSTU-PC-2026
