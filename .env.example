# ---- docker compose configuration -------------------------------------
# Copy to ".env" and fill in MONGO_ROOT_PASSWORD. Everything else has a
# working default.
#
#   cp .env.example .env
#   echo "MONGO_ROOT_PASSWORD=$(LC_ALL=C tr -dc 'A-Za-z0-9' </dev/urandom | head -c 40)" >> .env
#
# Use an ALPHANUMERIC password. docker-compose.yml assembles MONGO_URI from
# these values, and a MongoDB URI cannot carry unescaped + / = : @ — which is
# exactly what `openssl rand -base64` produces. The driver then rejects it with
# "Password contains unescaped characters". 40 alphanumeric characters is ~238
# bits, so nothing is lost by avoiding punctuation.
#
# .env is gitignored. Never commit real credentials.

# Host port to open the app on -> http://localhost:<CLIENT_PORT>
CLIENT_PORT=5173

# ---- Database ---------------------------------------------------------
# MongoDB runs with authentication on. There is deliberately no default
# password: compose fails to start rather than silently bringing up an open
# database.
# Must match the database your data is already in. This is the same default
# docker-compose.yml uses — changing it points the app at a different, empty
# database, which looks exactly like losing every registration.
MONGO_DB=pstu_it_carnival
MONGO_ROOT_USER=carnival
MONGO_ROOT_PASSWORD=

# MONGO_URI is assembled from the values above inside docker-compose.yml, so
# it is not set here. Override it only when pointing at an external database:
#   MONGO_URI=mongodb+srv://user:password@cluster.mongodb.net/dbname

# ---- Enabling auth on a database that already holds data --------------
# MONGO_INITDB_ROOT_* only applies when the data volume is empty. If
# pstu-mongo already has registrations, create the user once by hand:
#
#   docker compose up -d mongo
#   docker exec -it pstu-mongo mongosh --quiet admin --eval '
#     db.createUser({
#       user: "carnival",
#       pwd:  "PASTE_THE_SAME_PASSWORD_HERE",
#       roles: [{ role: "root", db: "admin" }]
#     })'
#   docker compose up -d --force-recreate
#
# If the data is disposable it is simpler to start clean. This DELETES every
# registration:
#
#   docker compose down -v && docker compose up -d --build

# ---- Bot protection (optional) ----------------------------------------
# Cloudflare Turnstile. Leave both blank and the registration form works
# exactly as before, protected by rate limiting alone. Set both to require a
# challenge: https://dash.cloudflare.com/?to=/:account/turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ---- Networking -------------------------------------------------------
# Rate limiting identifies callers by X-Forwarded-For. That header is only
# trustworthy when a reverse proxy you control sets it. Leave this "false"
# when the container is reached directly, otherwise anyone can forge the
# header and sidestep the limit.
TRUST_PROXY_HEADERS=false
