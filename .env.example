# ---- docker compose overrides (optional) ----
# Copy to ".env" to customise. Every value has a sensible default, so the
# stack also runs with `docker compose up` and no .env file at all.

# Host port to open the app on -> http://localhost:<CLIENT_PORT>
CLIENT_PORT=5173

# MongoDB database name (created automatically on first run)
MONGO_DB=pstu_it_carnival

# Prefix for generated registration IDs, e.g. PSTU-PC-2026-0001
REGISTRATION_ID_PREFIX=PSTU-PC-2026
